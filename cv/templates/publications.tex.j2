%!TEX TS-program = xelatex
%!TEX encoding = UTF-8 Unicode
%
% GENERATED by tools/build_cv.py --publist from _data/*.yml -- do not edit by hand.
% Edit the YAML, then run: python3 tools/build_cv.py
%
% Awesome-CV template by Claud D. Park, CC BY-SA 4.0
% https://github.com/posquit0/Awesome-CV

\documentclass[11pt, a4paper]{awesome-cv}
\usepackage{academicons}
% Lets a section demand enough room to stay whole, instead of leaving its
% heading orphaned at the foot of a page with the content overleaf.
\usepackage{needspace}

\geometry{left=1.4cm, top=.8cm, right=1.4cm, bottom=1.8cm, footskip=.5cm}
\fontdir[fonts/]

\definecolor{awesome}{HTML}{006699}
\setbool{acvSectionColorHighlight}{false}
\renewcommand{\acvHeaderSocialSep}{\quad\textbar\quad}

%-------------------------------------------------------------------------------
%	PERSONAL INFORMATION
%-------------------------------------------------------------------------------
\name{<< profile.name.first >>}{<< profile.name.last >>}
<% if profile.get('address') %>
\address{<< profile.address|tex >>}
<% else %>
\address{<< profile.institution|tex >>}
<% endif %>
\position{<< profile.position >>{\enskip\cdotp\enskip}<< profile.subtitle >>}

<% if profile.get('mobile') %>
\mobile{<< profile.mobile >>}
<% endif %>
\email{<< profile.email >>}
\github{<< profile.github >>}
\linkedin{<< profile.linkedin >>}
% \googlescholar{<id>}{<display name>} -- the id is what builds the profile URL.
\googlescholar{<< profile.google_scholar.id >>}{<< profile.google_scholar.short >>}
\extrainfo{\aiOrcid ~\href{https://orcid.org/<< profile.orcid >>}{<< profile.orcid >>}}

\begin{document}

\makecvheader
\makecvfooter
  {\today}
  {<< profile.name.first >> << profile.name.last >>~~~·~~~List of Publications}
  {\thepage}

\cvsection{Publications}

\needspace{6\baselineskip}
\cvsubsection{Selected articles}
\begin{cvpublications}
<% for p in publications.selected if p.bibtype != 'inproceedings' %>
  \cvpublication
    {<< p|authors >>}
    {``<< p.title|tex >>''<< p|venue >>}
    {<< p|publink >>}
<% endfor %>
\end{cvpublications}

<% if publications.get('collaboration') %>
\needspace{6\baselineskip}
\cvsubsection{As a member of the DUNE Collaboration (<< publications.collaboration|length >> papers)}
\begin{cvpublications}
<% for p in publications.collaboration %>
  \cvpublication
    {<< p|authors >>}
    {``<< p.title|tex >>''<< p|venue >>}
    {<< p|publink >>}
<% endfor %>
\end{cvpublications}
<% endif %>

<% if publications.selected|selectattr('bibtype', 'equalto', 'inproceedings')|list %>
\needspace{6\baselineskip}
\cvsubsection{Conference proceedings}
\begin{cvpublications}
<% for p in publications.selected if p.bibtype == 'inproceedings' %>
  \cvpublication
    {<< p|authors >>}
    {``<< p.title|tex >>''<< p|venue >>}
    {<< p|publink >>}
<% endfor %>
\end{cvpublications}
<% endif %>

\end{document}
