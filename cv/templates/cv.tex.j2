%!TEX TS-program = xelatex
%!TEX encoding = UTF-8 Unicode
%
% GENERATED by tools/build_cv.py from _data/*.yml -- do not edit by hand.
% Edit the YAML, then run: python3 tools/build_cv.py
%
% Awesome-CV template by Claud D. Park, CC BY-SA 4.0
% https://github.com/posquit0/Awesome-CV

\documentclass[11pt, a4paper]{awesome-cv}
\usepackage{academicons}
% Lets a section demand enough room to stay whole, instead of leaving its
% heading orphaned at the foot of a page with the content overleaf.
\usepackage{needspace}

\geometry{left=1.4cm, top=.8cm, right=1.4cm, bottom=1.8cm, footskip=.5cm}
\fontdir[fonts/]

\definecolor{awesome}{HTML}{006699}
\setbool{acvSectionColorHighlight}{false}
\renewcommand{\acvHeaderSocialSep}{\quad\textbar\quad}

%-------------------------------------------------------------------------------
%	PERSONAL INFORMATION
%-------------------------------------------------------------------------------
\name{<< profile.name.first >>}{<< profile.name.last >>}
<% if profile.get('address') %>
\address{<< profile.address|tex >>}
<% else %>
\address{<< profile.institution|tex >>}
<% endif %>
\position{<< profile.position >>{\enskip\cdotp\enskip}<< profile.subtitle >>}

<% if profile.get('mobile') %>
\mobile{<< profile.mobile >>}
<% endif %>
\email{<< profile.email >>}
\github{<< profile.github >>}
\linkedin{<< profile.linkedin >>}
% \googlescholar{<id>}{<display name>} -- the id is what builds the profile URL.
\googlescholar{<< profile.google_scholar.id >>}{<< profile.google_scholar.short >>}
\extrainfo{\aiOrcid ~\href{https://orcid.org/<< profile.orcid >>}{<< profile.orcid >>}}

\begin{document}

\makecvheader
\makecvfooter
  {\today}
  {<< profile.name.first >> << profile.name.last >>~~~·~~~Curriculum Vitae}
  {\thepage}

%-------------------------------------------------------------------------------
%	ACADEMIC EDUCATION
%-------------------------------------------------------------------------------
\cvsection{Academic Education}
\begin{cventries}
<% for e in education %>
  \cventry
    {<< e.degree|tex >>}
    {<< e.institution|tex >>}
    {<< e.location|tex >>}
    {<< e.dates|tex >><% if e.get('status') %> (<< e.status|tex >>)<% endif %>}
    {Thesis: << e.thesis|md >>}\vspace{0.18cm}
<% endfor %>
\end{cventries}
\vspace{-0.1cm}

%-------------------------------------------------------------------------------
%	WORK EXPERIENCE
%-------------------------------------------------------------------------------
\cvsection{Work Experience}

\cvsubsection{Responsibilities}
\begin{cventries}
  \vspace{-0.4cm}
  \cventry{}{}{}{}
  {\begin{itemize}[leftmargin=2ex, nosep, noitemsep]\vspace{-0.6cm}
<% for r in experience.responsibilities %>
    \item << r|md >>
<% endfor %>
  \end{itemize}}
\end{cventries}\vspace{0.1cm}

\cvsubsection{Positions}
\begin{cventries}
<% for p in experience.positions %>
  \cventry
    {<< p.title|tex >>}
    {<< p.organization|tex >>}
    {<< p.location|tex >>}
    {<< p.dates|tex >>}
<% if p.get('highlights') %>
    {
      \begin{cvitems}
<% for h in p.highlights %>
        \item {<< h|md >>}
<% endfor %>
      \end{cvitems}
    }\vspace{0.4cm}
<% else %>
    {<< p.get('summary','')|md >>}\vspace{0.18cm}
<% endif %>
<% endfor %>
\end{cventries}
\vspace{-0.1cm}

%-------------------------------------------------------------------------------
%	SKILLS
%-------------------------------------------------------------------------------
% Skills is short and reads badly split: if the whole section will not fit in
% what is left of the page, start it on the next one.
\needspace{15\baselineskip}
\cvsection{Skills}

\cvsubsection{Technical}
\begin{cvskills}
<% for s in skills.technical %>
  \cvskill
    {<< s.category|tex >>}
    {<< s.detail|md >>}
<% endfor %>
\end{cvskills}

\cvsubsection{Language}
\begin{cvskills}
<% for l in skills.languages %>
  \cvskill
    {<< l.name|tex >>}
    {<< l.level|tex >>. << l.detail|tex >>}
<% endfor %>
\end{cvskills}
\vspace{-0.1cm}

%-------------------------------------------------------------------------------
%	CONFERENCES AND SCHOOLS
%-------------------------------------------------------------------------------
<% for heading, group in talk_sections %>
\cvsection{<< heading >>}
\begin{cventries}
<% for t in group %>
  \cventry
    {<< t.kind|tex >>}
    {<< t.event|tex >>}
    {<< t.location|tex >>}
    {<< t.dates|tex >>}
    {<< t.title|md >>.}\vspace{0.15cm}
<% endfor %>
\end{cventries}
\vspace{-0.1cm}
<% endfor %>

\newpage
%-------------------------------------------------------------------------------
%	RESEARCH ACTIVITIES
%-------------------------------------------------------------------------------
\cvsection{Research Activities}
\begin{cventries}
<% for r in research %>
  \vspace{1.2cm}\cventry
    {\small << r.label|tex >>}
    {\large << r.title|tex >>}
    {<< r.location|tex >>}
    {<< r.dates|tex >>}
    {\vspace{.4cm}\begin{cvitems}
      \normalsize
<% for para in r.paragraphs %>
      \item{<< para|md >>}\vspace{.4cm}
<% endfor %>
    \end{cvitems}}
<% endfor %>
\end{cventries}

<% if publications %>
\newpage
%-------------------------------------------------------------------------------
%	PUBLICATIONS  (generated from INSPIRE-HEP by tools/fetch_inspire.py)
%-------------------------------------------------------------------------------
\cvsection{Publications}

\needspace{6\baselineskip}
\cvsubsection{Selected articles and proceedings}
\begin{cvpublications}
<% for p in publications.selected %>
  \cvpublication
    {<< p|authors >>}
    {``<< p.title|tex >>''<< p|venue >>}
    {<< p|publink >>}
<% endfor %>
\end{cvpublications}

<% if publications.get('collaboration') %>
% Keep this heading with at least the first few entries.
\needspace{6\baselineskip}
\cvsubsection{As a member of the DUNE Collaboration (<< publications.collaboration|length >> papers)}
\begin{cvpublications}
<% for p in publications.collaboration %>
  \cvpublication
    {<< p|authors >>}
    {``<< p.title|tex >>''<< p|venue >>}
    {<< p|publink >>}
<% endfor %>
\end{cvpublications}
<% endif %>
<% endif %>

\end{document}
